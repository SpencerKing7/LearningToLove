{
  "name": "learning-to-love",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://www.spencerking7.com",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist && ./scripts/generate-commit-message.sh > /tmp/commit-msg.txt && git add -A && git commit -F /tmp/commit-msg.txt && git push && rm /tmp/commit-msg.txt",
    "deploy-only": "gh-pages -d dist"
  },
  "dependencies": {
    "bootstrap": "^5.3.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "gh-pages": "^6.3.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
